{
	"name": "@mvd/event-target",
	"version": "0.0.1",
	"description": "Type-safe EventTarget for TypeScript: strongly-typed event names and CustomEvent.detail.",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "bunup",
		"prepublishOnly": "bun run build && publint",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"bunup": "^0.16.11",
		"publint": "^0.3.12"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
