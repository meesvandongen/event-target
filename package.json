{
	"name": "@mvd/event-target",
	"version": "0.0.1",
	"description": "Type-safe EventTarget for TypeScript: strongly-typed event names and CustomEvent.detail.",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/meesvandongen/event-target.git"
	},
	"author": "Mees van Dongen",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/meesvandongen/event-target/issues"
	},
	"homepage": "https://github.com/meesvandongen/event-target#readme",
	"scripts": {
		"build": "vp pack",
		"prepublishOnly": "pnpm run build && pnpm run publint",
		"typecheck": "tsc --noEmit",
		"lint": "vp lint",
		"fmt": "vp fmt",
		"fmt:check": "vp fmt --check",
		"publint": "publint"
	},
	"devDependencies": {
		"publint": "^0.3.12",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"typescript": "^5 || ^7.0.0"
	},
	"packageManager": "pnpm@12.20.0+sha512.6ccc74997ccef4e67999788e18dbfbfa583e2a849668668db4707b6a8306662f47156e650232a985bd3ec24cf9364c1aa154d37e51ed7aac62c1cd1e3afc80c3"
}
