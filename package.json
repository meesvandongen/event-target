{
	"name": "@mvd/event-target",
	"version": "0.0.1",
	"description": "Type-safe EventTarget for TypeScript: strongly-typed event names and CustomEvent.detail.",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/meesvandongen/event-target.git"
	},
	"author": "Mees van Dongen",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/meesvandongen/event-target/issues"
	},
	"homepage": "https://github.com/meesvandongen/event-target#readme",
	"scripts": {
		"build": "vp pack",
		"prepublishOnly": "pnpm run build && pnpm run publint",
		"typecheck": "tsc --noEmit",
		"lint": "vp lint",
		"fmt": "vp fmt",
		"fmt:check": "vp fmt --check",
		"publint": "publint"
	},
	"devDependencies": {
		"publint": "^0.3.12",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"typescript": "^5 || ^7.0.0"
	},
	"packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
