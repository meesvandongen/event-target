{
	"name": "@mvd/event-target",
	"version": "0.0.1",
	"description": "Type-safe EventTarget for TypeScript: strongly-typed event names and CustomEvent.detail.",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/meesvandongen/event-target.git"
	},
	"author": "Mees van Dongen",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/meesvandongen/event-target/issues"
	},
	"homepage": "https://github.com/meesvandongen/event-target#readme",
	"scripts": {
		"build": "vp pack",
		"prepublishOnly": "pnpm run build && pnpm run publint",
		"typecheck": "tsc --noEmit",
		"lint": "vp lint",
		"fmt": "vp fmt",
		"fmt:check": "vp fmt --check",
		"publint": "publint"
	},
	"devDependencies": {
		"publint": "^0.3.12",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"typescript": "^5 || ^7.0.0"
	},
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
