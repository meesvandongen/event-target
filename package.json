{
	"name": "@mvd/event-target",
	"version": "0.0.1",
	"description": "Type-safe EventTarget for TypeScript: strongly-typed event names and CustomEvent.detail.",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/meesvandongen/event-target.git"
	},
	"author": "Mees van Dongen",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/meesvandongen/event-target/issues"
	},
	"homepage": "https://github.com/meesvandongen/event-target#readme",
	"scripts": {
		"build": "bunup",
		"prepublishOnly": "bun run build && bun run publint",
		"typecheck": "tsc --noEmit",
		"publint": "publint"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"bunup": "^0.16.11",
		"publint": "^0.3.12"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
