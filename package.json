{
	"name": "@mvd/event-target",
	"version": "0.0.1",
	"description": "Type-safe EventTarget for TypeScript: strongly-typed event names and CustomEvent.detail.",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/meesvandongen/event-target.git"
	},
	"author": "Mees van Dongen",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/meesvandongen/event-target/issues"
	},
	"homepage": "https://github.com/meesvandongen/event-target#readme",
	"scripts": {
		"build": "vp pack",
		"prepublishOnly": "pnpm run build && pnpm run publint",
		"typecheck": "tsc --noEmit",
		"lint": "vp lint",
		"fmt": "vp fmt",
		"fmt:check": "vp fmt --check",
		"publint": "publint"
	},
	"devDependencies": {
		"publint": "^0.3.12",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"typescript": "^5 || ^7.0.0"
	},
	"packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
